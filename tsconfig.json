{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@cherryblossom/api-contract": ["./host/contract.ts"],
      "@cherryblossom/ai-models": ["./host/ai-models.ts"],
      "@cherryblossom/project-changes": ["./host/project-changes.ts"]
    }
  },
  "include": ["src", "tests", "host", "e2e", "vite.config.ts", "vitest.config.ts", "playwright.config.ts"]
}
