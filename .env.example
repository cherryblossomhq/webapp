# Copy to .env (gitignored) and fill in. Both are optional — without them the
# app runs in bring-your-own-Anthropic-key mode (Settings → AI).

# WorkOS AuthKit client id (public identifier — safe to bake into builds).
# Unset → the sign-in UI stays hidden and managed AI is unavailable.
# Register {origin}/callback (e.g. http://localhost:5173/callback) on the
# WorkOS environment's Redirects page for sign-in to complete.
#VITE_WORKOS_CLIENT_ID=client_...

# Managed AI proxy endpoint. Must pair with the WorkOS environment of
# VITE_WORKOS_CLIENT_ID. Unset → production proxy.
#VITE_MANAGED_AI_URL=https://www.trycherryblossom.com/api/v1/messages
