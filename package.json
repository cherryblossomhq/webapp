{
  "name": "cherryblossom-editor",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "description": "A browser-based schematic and PCB editor: schematic capture, layout, autorouting, copper pours, checks, a 3D view, and Gerber, KiCad and STEP export.",
  "keywords": [
    "pcb",
    "schematic",
    "eda",
    "electronics",
    "hardware",
    "circuit-design",
    "gerber",
    "kicad",
    "editor"
  ],
  "homepage": "https://github.com/cherryblossomhq/webapp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cherryblossomhq/webapp.git"
  },
  "bugs": {
    "url": "https://github.com/cherryblossomhq/webapp/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "examples": "vitest run tests/templates.test.ts -t \"ships as built\" -u",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@countertype/clipper2-ts": "^1.5.4-3.9a869ba",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource/geist-mono": "^5.2.8",
    "@tscircuit/circuit-json-util": "^0.0.123",
    "@tscircuit/footprinter": "^0.0.438",
    "circuit-json": "^0.0.528",
    "circuit-json-to-kicad": "^0.0.243",
    "earcut": "^3.2.4",
    "format-si-unit": "^0.0.7",
    "jszip": "^3.10.2",
    "kicadts": "^0.0.58",
    "lucide-react": "^1.57.0",
    "occt-import-js": "^0.0.23",
    "polygon-clipping": "^0.15.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "schematic-symbols": "^0.0.249",
    "three": "^0.186.1",
    "transformation-matrix": "^3.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tscircuit/alphabet": "^0.0.27",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.0",
    "circuit-json-to-connectivity-map": "^0.0.23",
    "circuit-to-svg": "^0.0.452",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.5"
  }
}
